# Rust
/target/
**/*.rs.bk
*.pdb

# Environment templates under /environments/ ARE source and are committed.
# Per-demo instances generated by the console are not: they carry prospect
# names and belong in the console's archive path, never in the repo.
/generated/
/archive/
*.local.yaml

# Netdata claim credentials must never be committed.
claim_token
claim.conf
.env

# The OTLP showcase builds its virtualenv on first run.
/otlp/.venv/
__pycache__/
